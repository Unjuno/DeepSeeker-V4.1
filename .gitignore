# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Local benchmark / profiling output (per-run artifacts stay ignored)
artifacts/
benchmarks/results/
profiles/*
!profiles/m1-max-64gb/
profiles/m1-max-64gb/*
# Canonical sanitized probe baseline (generated by scripts/probe_machine.py)
!profiles/m1-max-64gb/machine.json
!profiles/m1-max-64gb/benchmark.json
!profiles/m1-max-64gb/README.md
!profiles/m1-max-64gb/storage-patterns.json
!profiles/m1-max-64gb/storage-patterns.md
!profiles/m1-max-64gb/memory-capacity.json
!profiles/m1-max-64gb/resident-plan.json
!profiles/m1-max-64gb/resident-plan.md
!profiles/m1-max-64gb/checkpoint-status.json
profiles/deepseek-v4.1-flash/*
!profiles/deepseek-v4.1-flash/
!profiles/deepseek-v4.1-flash/dba1be0a40aa45a94ad051997016db3960a90277/
profiles/deepseek-v4.1-flash/dba1be0a40aa45a94ad051997016db3960a90277/*
# Canonical tensor manifest for the pinned upstream revision only
# (a new revision needs an explicit, reviewed .gitignore update)
!profiles/deepseek-v4.1-flash/dba1be0a40aa45a94ad051997016db3960a90277/model-manifest.json
!profiles/deepseek-v4.1-flash/dba1be0a40aa45a94ad051997016db3960a90277/storage-summary.md
!profiles/deepseek-v4.1-flash/dba1be0a40aa45a94ad051997016db3960a90277/engram-access.json
!profiles/deepseek-v4.1-flash/dba1be0a40aa45a94ad051997016db3960a90277/engram-access-summary.md
# Golden bench corpus + golden outputs are committed (Issue #17);
# per-run result.json files stay ignored (pass --out to /tmp).
!profiles/bench/
profiles/bench/*
!profiles/bench/corpus.json
!profiles/bench/golden-*.json
# FreeToken audit map is committed (Issue #18, machine-readable table).
!profiles/audit/
profiles/audit/*
!profiles/audit/freetoken-map.json
*.trace
*.prof
*.jsonl

# Models / weights
models/
weights/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt

# Upstream source fetched at runtime. Keep only its documentation.
upstream/*
!upstream/README.md

# Hugging Face cache
.cache/
!profiles/traces/
profiles/traces/*
!profiles/traces/*.jsonl
